{
  "name": "neptune-loop-cockpit",
  "version": "0.1.0",
  "description": "Open-source, read-only cockpit for the INJ collateral loop on Neptune Finance (Injective): connect Keplr or watch any address, see health/LTV, and get the strategy's next move. No keys, no backend, no transactions.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/paddy-droid/neptune-loop-cockpit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paddy-droid/neptune-loop-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/paddy-droid/neptune-loop-cockpit/issues"
  },
  "keywords": [
    "injective",
    "neptune-finance",
    "defi",
    "leverage-loop",
    "keplr",
    "cosmwasm",
    "inj",
    "dashboard",
    "strategy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx backtest/run.ts",
    "backtest:fetch": "node backtest/fetch-daily.mjs",
    "status": "tsx scripts/status-cli.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
