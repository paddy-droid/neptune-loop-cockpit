{
  "name": "neptune-loop-cockpit",
  "version": "0.2.0",
  "description": "Cockpit and autopilot for the INJ collateral loop on Neptune Finance (Injective): watch any address, connect Keplr or Leap, get the strategy's next move with concrete amounts, and optionally let it execute with a scoped session key. No backend, no stored owner keys.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/paddy-droid/neptune-loop-cockpit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paddy-droid/neptune-loop-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/paddy-droid/neptune-loop-cockpit/issues"
  },
  "keywords": [
    "injective",
    "neptune-finance",
    "defi",
    "leverage-loop",
    "keplr",
    "cosmwasm",
    "inj",
    "dashboard",
    "strategy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx backtest/run.ts",
    "backtest:fetch": "node backtest/fetch-daily.mjs",
    "status": "tsx scripts/status-cli.ts",
    "autopilot": "tsx scripts/autopilot.ts",
    "session": "tsx scripts/autopilot.ts generate"
  },
  "dependencies": {
    "@injectivelabs/core-proto-ts-v2": "^1.20.3",
    "@injectivelabs/networks": "^1.20.41",
    "@injectivelabs/sdk-ts": "^1.20.41",
    "@injectivelabs/ts-types": "^1.20.41",
    "@injectivelabs/utils": "^1.20.41",
    "@injectivelabs/wallet-base": "^1.20.41",
    "@injectivelabs/wallet-core": "^1.20.41",
    "@injectivelabs/wallet-strategy": "^1.20.41",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
